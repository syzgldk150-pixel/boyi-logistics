{
  "manifest_version": 3,
  "name": "博益原页助手",
  "version": "0.4.10",
  "description": "适配韵达、融辉和百世原页，登录后返回博益录单。无账号隔离，不收集登录信息。",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "cookies",
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "https://boyi.homes/*",
    "https://tms.ronghuiwl.com/*",
    "http://tms.ronghuiwl.com/*",
    "https://v5.800best.com/*",
    "http://v5.800best.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://v5.800best.com/baseService/transOrder/networkProductOrder*"],
      "js": ["best-storage.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://v5.800best.com/baseService/transOrder/networkProductOrder*"
      ],
      "js": ["best-entry.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://boyi.homes/*"
      ],
      "js": [
        "content.js",
        "layout-host.js",
        "original-login.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://tms.ronghuiwl.com/module/index*"
      ],
      "js": [
        "layout-shell.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://tms.ronghuiwl.com/widget/home*"
      ],
      "js": [
        "entry-events.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://ky-sso.yunda56.com/login*",
        "https://ky-sso.yunda56.com/public/feishu/login*"
      ],
      "css": [
        "yunda-login.css"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://ky-sso.yunda56.com/login*",
        "https://kyinms.yunda56.com/ky_inms/public/index.php/index/index.html*",
        "https://kyinms.yunda56.com/ky_inms/public/index.php/business/waybill/entry/indexNew.html*",
        "https://tms.ronghuiwl.com/module/index*",
        "https://v5.800best.com/login*",
        "https://v5.800best.com/baseService/transOrder/networkProductOrder*"
      ],
      "js": [
        "original-login.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
