{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.boyi.homes/schemas/service-v2/manifest-v2.schema.json",
  "title": "Boyi Service v2 plugin manifest",
  "description": "Authoring schema for Service v2 manifests. The runtime manifest parser and project contract remain authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_model",
    "plugin_id",
    "name",
    "version",
    "description",
    "host_api",
    "runtime",
    "provides",
    "requires",
    "capabilities",
    "account_roles",
    "resource_roles",
    "contributes",
    "config_schema",
    "storage"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "runtime_model": {
      "const": "service_v2"
    },
    "plugin_id": {
      "$ref": "#/$defs/plugin_id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "host_api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum_exclusive"
      ],
      "properties": {
        "minimum": {
          "$ref": "#/$defs/semver"
        },
        "maximum_exclusive": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "python",
        "mode",
        "entrypoint",
        "requirements_lock",
        "wheelhouse"
      ],
      "properties": {
        "kind": {
          "const": "python_subprocess"
        },
        "python": {
          "const": "3.10"
        },
        "mode": {
          "enum": [
            "on_demand",
            "resident"
          ]
        },
        "entrypoint": {
          "$ref": "#/$defs/python_payload_path"
        },
        "requirements_lock": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^payload/(?!.*(?:^|/)\\.\\.?/).+\\.lock$",
              "maxLength": 240
            }
          ]
        },
        "wheelhouse": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^payload/wheelhouse/.+\\.whl$",
            "maxLength": 240
          }
        }
      }
    },
    "provides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/provided_service"
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/required_service"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "account_roles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/account_role"
      }
    },
    "resource_roles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource_role"
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "console",
        "scheduler",
        "webhook",
        "feishu",
        "events"
      ],
      "properties": {
        "console": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/console_contribution"
          }
        },
        "scheduler": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scheduler_contribution"
          }
        },
        "webhook": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/webhook_contribution"
          }
        },
        "feishu": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feishu_contribution"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event_contribution"
          }
        },
        "harness": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/harness_contribution"
          }
        },
        "module_slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/module_slot_contribution"
          }
        }
      }
    },
    "config_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "additionalProperties",
        "properties",
        "required"
      ],
      "properties": {
        "type": {
          "const": "object"
        },
        "additionalProperties": {
          "const": false
        },
        "properties": {
          "type": "object"
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kv",
        "collections"
      ],
      "properties": {
        "kv": {
          "type": "boolean"
        },
        "collections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/storage_collection"
          }
        }
      }
    }
  },
  "$defs": {
    "plugin_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 32
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "service": {
      "type": "string",
      "pattern": "^plugin\\.[a-z][a-z0-9_]{1,63}\\.[a-z][a-z0-9_.-]{0,127}@(0|[1-9][0-9]*)$",
      "maxLength": 220
    },
    "connector_service": {
      "type": "string",
      "pattern": "^connector\\.[a-z][a-z0-9_]{1,63}\\.[a-z][a-z0-9_.-]{0,127}@(0|[1-9][0-9]*)$",
      "maxLength": 220
    },
    "required_service": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "service"
          ],
          "properties": {
            "service": {
              "$ref": "#/$defs/service"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "service",
            "binding_kind",
            "account_role"
          ],
          "properties": {
            "service": {
              "$ref": "#/$defs/connector_service"
            },
            "binding_kind": {
              "const": "account"
            },
            "account_role": {
              "$ref": "#/$defs/role"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "service",
            "binding_kind",
            "resource_role"
          ],
          "properties": {
            "service": {
              "$ref": "#/$defs/connector_service"
            },
            "binding_kind": {
              "const": "resource"
            },
            "resource_role": {
              "$ref": "#/$defs/role"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "service",
            "binding_kind"
          ],
          "properties": {
            "service": {
              "$ref": "#/$defs/connector_service"
            },
            "binding_kind": {
              "const": "host_internal"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "service",
            "account_role"
          ],
          "properties": {
            "service": {
              "$ref": "#/$defs/connector_service"
            },
            "account_role": {
              "$ref": "#/$defs/role"
            }
          }
        }
      ]
    },
    "python_payload_path": {
      "type": "string",
      "pattern": "^payload/(?!.*(?:^|/)\\.\\.?/).+\\.py$",
      "maxLength": 240
    },
    "operation_target": {
      "type": "object",
      "required": [
        "id",
        "service",
        "operation",
        "default_enabled"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/role"
        },
        "service": {
          "$ref": "#/$defs/service"
        },
        "operation": {
          "$ref": "#/$defs/identifier"
        },
        "default_enabled": {
          "type": "boolean"
        }
      }
    },
    "provided_service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "operations"
      ],
      "properties": {
        "service": {
          "$ref": "#/$defs/service"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "effect"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/identifier"
              },
              "effect": {
                "enum": [
                  "read",
                  "compute",
                  "internal_write",
                  "external_write",
                  "destructive"
                ]
              }
            }
          }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "operations",
        "account_role",
        "resource_role"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "account_role": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/role"
            }
          ]
        },
        "resource_role": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/role"
            }
          ]
        },
        "action_call_limits": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1000,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "action_call_limits"
            ]
          },
          "then": {
            "properties": {
              "name": {
                "const": "service.invoke"
              }
            }
          }
        }
      ]
    },
    "account_role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "allowed_systems",
        "required"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "allowed_systems": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "resource_role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "allowed_kinds",
        "required"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "allowed_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "console_contribution": {
      "allOf": [
        {
          "$ref": "#/$defs/operation_target"
        },
        {
          "type": "object",
          "required": [
            "title"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "selection_preview_operation": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "scheduler_contribution": {
      "allOf": [
        {
          "$ref": "#/$defs/operation_target"
        },
        {
          "type": "object",
          "required": [
            "title"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "schedule": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "expression",
                "timezone"
              ],
              "properties": {
                "kind": {
                  "const": "cron"
                },
                "expression": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "timezone": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "default_enabled": {
                    "const": true
                  }
                },
                "required": [
                  "default_enabled"
                ]
              },
              "then": {
                "required": [
                  "schedule"
                ]
              }
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "webhook_contribution": {
      "allOf": [
        {
          "$ref": "#/$defs/operation_target"
        },
        {
          "type": "object",
          "required": [
            "method",
            "route"
          ],
          "properties": {
            "method": {
              "enum": [
                "POST"
              ]
            },
            "route": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "feishu_contribution": {
      "allOf": [
        {
          "$ref": "#/$defs/operation_target"
        },
        {
          "type": "object",
          "required": [
            "commands"
          ],
          "properties": {
            "commands": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "selection_preview_operation": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "event_contribution": {
      "allOf": [
        {
          "$ref": "#/$defs/operation_target"
        },
        {
          "type": "object",
          "required": [
            "event",
            "durable"
          ],
          "properties": {
            "event": {
              "$ref": "#/$defs/identifier"
            },
            "durable": {
              "type": "boolean"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "harness_contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "service",
        "operation",
        "effect"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/role"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "service": {
          "$ref": "#/$defs/service"
        },
        "operation": {
          "$ref": "#/$defs/identifier"
        },
        "effect": {
          "enum": [
            "read",
            "compute"
          ]
        }
      }
    },
    "module_slot_contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slot",
        "title",
        "service",
        "operation",
        "default_enabled"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/role"
        },
        "slot": {
          "enum": [
            "waybill_entry.actions",
            "waybill_entry.validators"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "service": {
          "$ref": "#/$defs/service"
        },
        "operation": {
          "$ref": "#/$defs/identifier"
        },
        "default_enabled": {
          "type": "boolean"
        }
      }
    },
    "storage_collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "fields",
        "indexes",
        "unique_constraints"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/role"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "required"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/role"
              },
              "type": {
                "enum": [
                  "string",
                  "integer",
                  "number",
                  "boolean",
                  "datetime",
                  "json"
                ]
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        },
        "indexes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "fields"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/role"
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/role"
                }
              }
            }
          }
        },
        "unique_constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "fields"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/role"
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/role"
                }
              }
            }
          }
        }
      }
    }
  }
}
