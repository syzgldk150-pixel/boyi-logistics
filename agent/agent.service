[Unit]
Description=Logistics Agent Service
After=network.target mysqld.service
Wants=mysqld.service

[Service]
Type=simple
User=boyce
Group=boyce
WorkingDirectory=/home/boyce/agent
ExecStart=/home/boyce/agent/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 9000 --log-level info
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/boyce:/home/boyce/agent
Environment=AGENT_HOST=127.0.0.1
EnvironmentFile=/home/boyce/agent/runtime/automation_plugin_release.env

# 价格采集和财务原页同步会启动浏览器或重任务子进程，需预留足够 cgroup 空间
MemoryHigh=900M
MemoryMax=1400M

[Install]
WantedBy=multi-user.target
