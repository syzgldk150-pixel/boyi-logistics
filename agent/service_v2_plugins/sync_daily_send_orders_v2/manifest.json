{
  "schema_version": 2,
  "runtime_model": "service_v2",
  "plugin_id": "sync_daily_send_orders_v2",
  "name": "获取当日寄件数据",
  "version": "2.2.1",
  "description": "获取当日寄件数据：插件独立完成分页、字段转换和输出；宿主提供平台读写与数据库接口。",
  "host_api": {
    "minimum": "2.0.0",
    "maximum_exclusive": "3.0.0"
  },
  "runtime": {
    "kind": "python_subprocess",
    "python": "3.10",
    "mode": "on_demand",
    "entrypoint": "payload/main.py",
    "requirements_lock": null,
    "wheelhouse": []
  },
  "settings_ui": {
    "entry": "settings/index.html",
    "bridge_api": "1.0.0"
  },
  "provides": [
    {
      "service": "plugin.sync_daily_send_orders_v2.daily_send@1",
      "operations": [
        {
          "name": "run",
          "effect": "external_write"
        }
      ]
    }
  ],
  "requires": [
    {
      "service": "connector.boyi.daily_send_source@1",
      "binding_kind": "account",
      "account_role": "daily_send_source"
    },
    {
      "service": "connector.boyi.send_order_bitable@1",
      "binding_kind": "resource",
      "resource_role": "send_order_bitable"
    }
  ],
  "capabilities": [
    {
      "name": "service.invoke",
      "operations": [
        "acquire",
        "delete_records",
        "export_workbook",
        "list_records",
        "read_page",
        "release",
        "replace_date",
        "write_records"
      ],
      "account_role": null,
      "resource_role": null
    }
  ],
  "account_roles": [
    {
      "role": "daily_send_source",
      "allowed_systems": [
        "ronghui"
      ],
      "required": true
    }
  ],
  "resource_roles": [
    {
      "role": "send_order_bitable",
      "allowed_kinds": [
        "feishu_bitable"
      ],
      "required": true
    }
  ],
  "contributes": {
    "console": [
      {
        "id": "manual_run",
        "title": "获取当日寄件数据",
        "service": "plugin.sync_daily_send_orders_v2.daily_send@1",
        "operation": "run",
        "default_enabled": true
      }
    ],
    "scheduler": [
      {
        "id": "daily_run",
        "title": "获取当日寄件数据",
        "service": "plugin.sync_daily_send_orders_v2.daily_send@1",
        "operation": "run",
        "default_enabled": false
      }
    ],
    "webhook": [],
    "feishu": [
      {
        "id": "command",
        "service": "plugin.sync_daily_send_orders_v2.daily_send@1",
        "operation": "run",
        "commands": [
          "获取当日寄件数据"
        ],
        "default_enabled": false
      }
    ],
    "events": [],
    "harness": []
  },
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "target_date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "minLength": 10,
        "maxLength": 10,
        "description": "留空就每次处理当天；填写后每次都只拉这一天，用完请清空。"
      },
      "start_date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "minLength": 10,
        "maxLength": 10,
        "description": "补拉一段日期时填写，和补拉结束日期一起用；填了会忽略业务日期。补拉完请清空。"
      },
      "end_date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "minLength": 10,
        "maxLength": 10,
        "description": "和补拉开始日期一起用，包含这一天。补拉完请清空。"
      },
      "page_size": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500,
        "description": "融辉寄件列表每页读取多少条，默认 100"
      },
      "max_pages": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "description": "最多读取多少页，默认 50"
      },
      "sql_only": {
        "type": "boolean",
        "description": "打开后只更新后台运单表，不写入、也不删除飞书记录。默认关闭"
      },
      "sync_sql": {
        "type": "boolean",
        "description": "更新后台“寄件运单查询”用的数据。默认开启"
      },
      "sync_nas": {
        "type": "boolean",
        "description": "写入 NAS 的“融辉寄件/日期.xlsx”，两个融辉账号合在同一张表，按来源网点区分。默认开启"
      }
    },
    "required": []
  },
  "storage": {
    "kv": false,
    "collections": []
  }
}
