{
  "schema_version": 2,
  "runtime_model": "service_v2",
  "plugin_id": "customer_problem_auto_reply_v2",
  "name": "客服问题件自动回复",
  "version": "1.1.0",
  "description": "只对人工授权自动处理的模板：AI 起草且按模板生成、把握足够的回复，由宿主回读核对后发出；每条问题件最多自动回复一次。",
  "host_api": {
    "minimum": "2.0.0",
    "maximum_exclusive": "3.0.0"
  },
  "runtime": {
    "kind": "python_subprocess",
    "python": "3.10",
    "mode": "on_demand",
    "entrypoint": "payload/main.py",
    "requirements_lock": null,
    "wheelhouse": []
  },
  "settings_ui": {
    "entry": "settings/index.html",
    "bridge_api": "1.0.0"
  },
  "provides": [
    {
      "service": "plugin.customer_problem_auto_reply_v2.auto_reply@1",
      "operations": [
        {
          "name": "run",
          "effect": "external_write"
        }
      ]
    }
  ],
  "requires": [
    {
      "service": "connector.boyi.customer_auto_reply@1",
      "binding_kind": "host_internal"
    }
  ],
  "capabilities": [
    {
      "name": "service.invoke",
      "operations": [
        "candidates",
        "draft",
        "reply"
      ],
      "action_call_limits": {
        "candidates": 1,
        "draft": 20,
        "reply": 20
      },
      "account_role": null,
      "resource_role": null
    }
  ],
  "account_roles": [
    {
      "role": "customer_service_source",
      "allowed_systems": [
        "ronghui",
        "yunda"
      ],
      "required": true,
      "collection": true
    }
  ],
  "resource_roles": [],
  "contributes": {
    "console": [
      {
        "id": "manual_run",
        "title": "处理一轮客服自动回复",
        "service": "plugin.customer_problem_auto_reply_v2.auto_reply@1",
        "operation": "run",
        "default_enabled": true
      }
    ],
    "scheduler": [
      {
        "id": "scheduled_run",
        "title": "客服自动回复",
        "service": "plugin.customer_problem_auto_reply_v2.auto_reply@1",
        "operation": "run",
        "default_enabled": false
      }
    ],
    "webhook": [],
    "feishu": [],
    "events": [],
    "harness": []
  },
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "max_per_run": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20,
        "description": "每轮最多尝试的问题件数（每件都要经 AI 起草和平台回读，数量大时一轮耗时较长）"
      },
      "flow": {
        "type": "object",
        "description": "处理流程：由哪些步骤组成、按什么条件筛选。只能用插件声明的积木，由宿主按规则校验后保存。",
        "x-flow": {
          "fields": {
            "platform": {
              "title": "平台",
              "type": "string",
              "enum": [
                "ronghui",
                "yunda"
              ]
            },
            "scenario": {
              "title": "问题类型",
              "type": "string",
              "enum": [
                "urge",
                "undelivered",
                "sign_dispute",
                "address",
                "reroute",
                "modify_info",
                "other"
              ]
            },
            "confidence": {
              "title": "AI 把握",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "blocks": [
            {
              "id": "candidates",
              "title": "找出待回复的问题件",
              "description": "从已发布数据中取出仍需回复、从未自动回复过的问题件",
              "effect": "read",
              "required": true,
              "params": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "max_items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                  }
                },
                "required": []
              },
              "provides_fields": [
                "platform"
              ]
            },
            {
              "id": "filter",
              "title": "按条件筛选",
              "description": "只让符合条件的问题件进入下一步",
              "effect": "compute",
              "repeatable": true,
              "condition": true
            },
            {
              "id": "draft",
              "title": "AI 起草并判断能否自动回复",
              "description": "必须是已授权自动处理的模板、回复按模板生成、AI 把握足够",
              "effect": "read",
              "required": true,
              "locked": true,
              "requires_before": [
                "candidates"
              ],
              "provides_fields": [
                "scenario",
                "confidence"
              ]
            },
            {
              "id": "reply",
              "title": "回复原平台并回读核对",
              "description": "宿主写前读平台防重复，写后回读确认",
              "effect": "external_write",
              "required": true,
              "locked": true,
              "requires_before": [
                "draft"
              ]
            }
          ],
          "default": {
            "steps": [
              {
                "block": "candidates",
                "params": {
                  "max_items": 5
                }
              },
              {
                "block": "draft"
              },
              {
                "block": "reply"
              }
            ]
          }
        }
      }
    },
    "required": []
  },
  "storage": {
    "kv": false,
    "collections": []
  }
}
