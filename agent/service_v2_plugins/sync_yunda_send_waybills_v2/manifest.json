{
  "schema_version": 2,
  "runtime_model": "service_v2",
  "plugin_id": "sync_yunda_send_waybills_v2",
  "name": "韵达寄件运单同步",
  "version": "2.2.1",
  "description": "韵达寄件运单同步：插件独立完成分页、字段适配、核对与输出，宿主只提供平台和存储接口。",
  "host_api": {
    "minimum": "2.0.0",
    "maximum_exclusive": "3.0.0"
  },
  "runtime": {
    "kind": "python_subprocess",
    "python": "3.10",
    "mode": "on_demand",
    "entrypoint": "payload/main.py",
    "requirements_lock": null,
    "wheelhouse": []
  },
  "settings_ui": {
    "entry": "settings/index.html",
    "bridge_api": "1.0.0"
  },
  "provides": [
    {
      "service": "plugin.sync_yunda_send_waybills_v2.yunda_send@1",
      "operations": [
        {
          "name": "preview",
          "effect": "read"
        },
        {
          "name": "run",
          "effect": "external_write"
        }
      ]
    }
  ],
  "requires": [
    {
      "service": "connector.boyi.yunda_send_source@1",
      "binding_kind": "account",
      "account_role": "yunda_send_source"
    },
    {
      "service": "connector.boyi.send_waybills_bitable@1",
      "binding_kind": "resource",
      "resource_role": "send_waybills_bitable"
    },
    {
      "service": "connector.boyi.send_waybills_sheet@1",
      "binding_kind": "resource",
      "resource_role": "send_waybills_sheet"
    },
    {
      "service": "connector.boyi.yunda_send_projection@1",
      "binding_kind": "host_internal"
    }
  ],
  "capabilities": [
    {
      "name": "service.invoke",
      "operations": [
        "commit",
        "export_workbook",
        "original_data",
        "renderer_detail",
        "replace_date",
        "send_page",
        "special_line_page",
        "tracking_detail"
      ],
      "account_role": null,
      "resource_role": null
    }
  ],
  "account_roles": [
    {
      "role": "yunda_send_source",
      "allowed_systems": [
        "yunda"
      ],
      "required": true
    }
  ],
  "resource_roles": [
    {
      "role": "send_waybills_bitable",
      "allowed_kinds": [
        "feishu_bitable"
      ],
      "required": true
    },
    {
      "role": "send_waybills_sheet",
      "allowed_kinds": [
        "feishu_sheet"
      ],
      "required": true
    }
  ],
  "contributes": {
    "console": [
      {
        "id": "manual_run",
        "title": "韵达寄件运单同步",
        "service": "plugin.sync_yunda_send_waybills_v2.yunda_send@1",
        "operation": "run",
        "default_enabled": true
      }
    ],
    "scheduler": [
      {
        "id": "daily_run",
        "title": "韵达寄件运单同步",
        "service": "plugin.sync_yunda_send_waybills_v2.yunda_send@1",
        "operation": "run",
        "default_enabled": false
      }
    ],
    "webhook": [],
    "feishu": [{"id": "command", "service": "plugin.sync_yunda_send_waybills_v2.yunda_send@1", "operation": "run", "commands": ["韵达寄件运单同步"], "default_enabled": false}],
    "events": [],
    "harness": [
      {
        "id": "assistant_preview",
        "title": "预览韵达寄件运单同步",
        "description": "只读检查韵达寄件运单同步",
        "scenarios": [
          "预览韵达寄件运单同步"
        ],
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        },
        "service": "plugin.sync_yunda_send_waybills_v2.yunda_send@1",
        "operation": "preview",
        "effect": "read",
        "confirmation_policy": "none",
        "preview_operation": null
      }
    ]
  },
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "target_date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "minLength": 10,
        "maxLength": 10,
        "description": "留空就每次处理当天；填写后每次都只拉这一天，用完请清空。"
      },
      "start_date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "minLength": 10,
        "maxLength": 10,
        "description": "补拉一段日期时填写；只填开始日期就只拉这一天。填了会忽略业务日期。补拉完请清空。"
      },
      "end_date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "minLength": 10,
        "maxLength": 10,
        "description": "和补拉开始日期一起用，包含这一天。补拉完请清空。"
      },
      "sync_sheet": {
        "type": "boolean",
        "description": "同时更新飞书电子表格副本。默认开启"
      },
      "ensure_fields": {
        "type": "boolean",
        "description": "写入前检查并创建多维表缺少的字段。默认开启"
      },
      "page_size": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "韵达列表每页读取多少条，默认 200"
      },
      "max_pages": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "description": "最多读取多少页，默认 50"
      },
      "sql_only": {
        "type": "boolean",
        "description": "打开后只更新后台运单表，不写入、也不删除飞书多维表和电子表格。默认关闭"
      },
      "sync_sql": {
        "type": "boolean",
        "description": "更新后台“寄件运单查询”用的数据。默认开启"
      },
      "sync_nas": {
        "type": "boolean",
        "description": "写入 NAS 的“韵达寄件/日期.xlsx”。默认开启"
      }
    },
    "required": []
  },
  "storage": {
    "kv": false,
    "collections": []
  }
}
