{
  "schema_version": 2,
  "runtime_model": "service_v2",
  "plugin_id": "sync_daily_should_sign_v2",
  "name": "每日应签",
  "version": "2.1.7",
  "description": "读取R13过去30天未签收清单与统计累计到货数，按实际行数维护12列报表及件数不一致的黄色条件格式，并回读核验。",
  "host_api": {
    "minimum": "2.0.0",
    "maximum_exclusive": "3.0.0"
  },
  "runtime": {
    "kind": "python_subprocess",
    "python": "3.10",
    "mode": "on_demand",
    "entrypoint": "payload/main.py",
    "requirements_lock": null,
    "wheelhouse": []
  },
  "settings_ui": {
    "entry": "settings/index.html",
    "bridge_api": "1.0.0"
  },
  "provides": [
    {
      "service": "plugin.sync_daily_should_sign_v2.daily_sign@1",
      "operations": [
        {
          "name": "run",
          "effect": "external_write"
        }
      ]
    }
  ],
  "requires": [
    {
      "service": "connector.boyi.daily_sign_r13@1",
      "binding_kind": "account",
      "account_role": "daily_sign_r13"
    },
    {
      "service": "connector.boyi.daily_sign_store@1",
      "binding_kind": "host_internal"
    },
    {
      "service": "connector.boyi.daily_sign_bitable@1",
      "binding_kind": "resource",
      "resource_role": "daily_sign_bitable"
    },
    {
      "service": "connector.boyi.daily_sign_sheet@1",
      "binding_kind": "resource",
      "resource_role": "daily_sign_sheet"
    }
  ],
  "capabilities": [
    {
      "name": "service.invoke",
      "operations": [
        "build_marker",
        "clear_sheet",
        "create_field",
        "delete_records",
        "describe",
        "finish_run",
        "list_fields",
        "list_records",
        "load_state",
        "persist_snapshot",
        "read_r13",
        "read_sheet",
        "read_sheet_formats",
        "source_scope",
        "start_run",
        "update_field",
        "verify_run",
        "verify_snapshot",
        "write_records",
        "write_sheet",
        "write_sheet_format"
      ],
      "account_role": null,
      "resource_role": null
    }
  ],
  "account_roles": [
    {
      "role": "daily_sign_r13",
      "allowed_systems": [
        "r13"
      ],
      "required": true
    },
    {
      "role": "daily_sign_tms",
      "allowed_systems": [
        "ronghui"
      ],
      "required": false
    }
  ],
  "resource_roles": [
    {
      "role": "daily_sign_bitable",
      "allowed_kinds": [
        "feishu_bitable"
      ],
      "required": true
    },
    {
      "role": "daily_sign_sheet",
      "allowed_kinds": [
        "feishu_sheet"
      ],
      "required": true
    }
  ],
  "contributes": {
    "console": [
      {
        "id": "manual_run",
        "title": "每日应签",
        "service": "plugin.sync_daily_should_sign_v2.daily_sign@1",
        "operation": "run",
        "default_enabled": true
      }
    ],
    "scheduler": [
      {
        "id": "daily_run",
        "title": "每日应签",
        "service": "plugin.sync_daily_should_sign_v2.daily_sign@1",
        "operation": "run",
        "default_enabled": false
      }
    ],
    "webhook": [],
    "feishu": [
      {
        "id": "command",
        "service": "plugin.sync_daily_should_sign_v2.daily_sign@1",
        "operation": "run",
        "commands": [
          "每日应签"
        ],
        "default_enabled": false
      }
    ],
    "events": [],
    "harness": []
  },
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enrich_addresses": {
        "type": "boolean",
        "description": "历史配置保留；应签输出使用R13原页地址，不再从其他来源补齐"
      },
      "days": {
        "type": "integer",
        "minimum": 1,
        "maximum": 366,
        "description": "历史配置保留；每日应签固定查询北京时间过去30天，不再使用此值扩大范围"
      },
      "source_start": {
        "type": "string",
        "description": "历史配置保留；当前仅查询 R13，不再使用此项补查其他来源"
      },
      "source_end": {
        "type": "string",
        "description": "历史配置保留；当前仅查询 R13，不再使用此项补查其他来源"
      },
      "problem_page_size": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "历史配置保留；当前仅查询 R13，不再使用此项补查其他来源"
      },
      "problem_max_pages": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5000,
        "description": "历史配置保留；当前仅查询 R13，不再使用此项补查其他来源"
      },
      "problem_retry_attempts": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5,
        "description": "历史配置保留；当前仅查询 R13，不再使用此项补查其他来源"
      },
      "problem_timeout_sec": {
        "type": "integer",
        "minimum": 30,
        "maximum": 7200,
        "description": "历史配置保留；当前仅查询 R13，不再使用此项补查其他来源"
      },
      "sign_page_size": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "description": "历史配置保留；当前仅查询 R13，不再使用此项补查其他来源"
      },
      "sign_max_pages": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5000,
        "description": "历史配置保留；当前仅查询 R13，不再使用此项补查其他来源"
      },
      "sign_chunk_days": {
        "type": "integer",
        "minimum": 1,
        "maximum": 366,
        "description": "历史配置保留；当前仅查询 R13，不再使用此项补查其他来源"
      },
      "sign_retry_attempts": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5,
        "description": "历史配置保留；当前仅查询 R13，不再使用此项补查其他来源"
      },
      "sign_timeout_sec": {
        "type": "integer",
        "minimum": 30,
        "maximum": 7200,
        "description": "历史配置保留；当前仅查询 R13，不再使用此项补查其他来源"
      },
      "waybill_timeout_sec": {
        "type": "integer",
        "description": "历史配置保留；当前仅查询 R13，不再使用此项补查其他来源"
      },
      "browser_batch_size": {
        "type": "integer",
        "description": "历史配置保留；当前仅查询 R13，不再使用此项补查其他来源"
      },
      "sign_site_code": {
        "type": "string",
        "minLength": 1,
        "description": "历史配置保留；当前仅查询 R13，不再使用此项补查其他来源"
      },
      "exact_sign_conflict_limit": {
        "type": "integer",
        "minimum": 0,
        "description": "历史配置保留；当前仅查询 R13，不再使用此项补查其他来源"
      },
      "exact_historical_sign_limit": {
        "type": "integer",
        "minimum": 0,
        "description": "历史配置保留；当前仅查询 R13，不再使用此项补查其他来源"
      }
    },
    "required": []
  },
  "storage": {
    "kv": false,
    "collections": []
  }
}
