{
  "schema_version": 2,
  "runtime_model": "service_v2",
  "plugin_id": "sync_delivery_status_v2",
  "name": "查询并更新签收状态",
  "version": "2.0.1",
  "description": "查询并更新签收状态：插件独立完成分页、字段转换和输出；宿主提供平台读写与数据库接口。",
  "host_api": {
    "minimum": "2.0.0",
    "maximum_exclusive": "3.0.0"
  },
  "runtime": {
    "kind": "python_subprocess",
    "python": "3.10",
    "mode": "on_demand",
    "entrypoint": "payload/main.py",
    "requirements_lock": null,
    "wheelhouse": []
  },
  "settings_ui": {
    "entry": "settings/index.html",
    "bridge_api": "1.0.0"
  },
  "provides": [
    {
      "service": "plugin.sync_delivery_status_v2.delivery@1",
      "operations": [
        {
          "name": "preview",
          "effect": "read"
        },
        {
          "name": "run",
          "effect": "external_write"
        }
      ]
    }
  ],
  "requires": [
    {
      "service": "connector.boyi.delivery_source@1",
      "binding_kind": "account",
      "account_role": "delivery_source"
    },
    {
      "service": "connector.boyi.delivery_status_bitable@1",
      "binding_kind": "resource",
      "resource_role": "delivery_status_bitable"
    }
  ],
  "capabilities": [
    {
      "name": "service.invoke",
      "operations": [
        "list_records",
        "list_views",
        "read_status",
        "update_projection",
        "write_records"
      ],
      "account_role": null,
      "resource_role": null
    }
  ],
  "account_roles": [
    {
      "role": "delivery_source",
      "allowed_systems": [
        "ronghui"
      ],
      "required": true
    }
  ],
  "resource_roles": [
    {
      "role": "delivery_status_bitable",
      "allowed_kinds": [
        "feishu_bitable"
      ],
      "required": true
    }
  ],
  "contributes": {
    "console": [
      {
        "id": "manual_run",
        "title": "查询并更新签收状态",
        "service": "plugin.sync_delivery_status_v2.delivery@1",
        "operation": "run",
        "default_enabled": true
      }
    ],
    "scheduler": [
      {
        "id": "daily_run",
        "title": "查询并更新签收状态",
        "service": "plugin.sync_delivery_status_v2.delivery@1",
        "operation": "run",
        "default_enabled": false
      }
    ],
    "webhook": [
      {
        "id": "webhook",
        "service": "plugin.sync_delivery_status_v2.delivery@1",
        "operation": "run",
        "method": "POST",
        "route": "sign-status",
        "default_enabled": false,
        "dynamic_fields": [
          "BILL_CODE",
          "RECORD_ID"
        ]
      }
    ],
    "feishu": [
      {
        "id": "command",
        "service": "plugin.sync_delivery_status_v2.delivery@1",
        "operation": "run",
        "commands": [
          "查询并更新签收状态"
        ],
        "default_enabled": false
      }
    ],
    "events": [],
    "harness": [
      {
        "id": "assistant_preview",
        "title": "预览查询并更新签收状态",
        "description": "预览查询并更新签收状态",
        "scenarios": [
          "预览查询并更新签收状态"
        ],
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        },
        "service": "plugin.sync_delivery_status_v2.delivery@1",
        "operation": "preview",
        "effect": "read",
        "confirmation_policy": "none",
        "preview_operation": null
      }
    ]
  },
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "bill_codes": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "运单号列表"
      },
      "record_ids": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "与 bill_codes 一一对应的飞书 record_id 列表"
      },
      "BILL_CODE": {
        "type": "string",
        "description": "兼容 N8N webhook 查询参数：逗号分隔运单号"
      },
      "RECORD_ID": {
        "type": "string",
        "description": "兼容 N8N webhook 查询参数：逗号分隔 record_id"
      },
      "list_limit": {
        "type": "integer",
        "description": "可选，每页读取飞书记录数，默认 200；飞书多维表格列表接口单页上限按 200 处理"
      },
      "query_batch_size": {
        "type": "integer",
        "description": "可选，每批查询签收状态的运单数，默认 100"
      }
    },
    "required": []
  },
  "storage": {
    "kv": false,
    "collections": []
  }
}
