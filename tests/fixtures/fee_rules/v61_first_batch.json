     "label": "码放上架件数",
     "type": "number",
     "integer": true,
     "unit": "件",
     "min": "0",
     "max": "100000",
     "default": "0"
    },
    {
     "key": "shelf_high",
     "label": "货架高于 1.7 米",
     "type": "bool",
     "default": false
    },
    {
     "key": "room_count",
     "label": "分房号码放的房间/仓库数",
     "type": "number",
     "integer": true,
     "unit": "个",
     "min": "0",
     "max": "1000",
     "default": "0"
