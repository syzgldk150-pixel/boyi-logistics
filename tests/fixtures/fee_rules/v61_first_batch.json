{
 "upstairs": {
  "name": "上楼费",
  "content": {
   "schema": 1,
   "params": [
    {
     "key": "settlement_weight",
     "label": "结算重量",
     "type": "number",
     "integer": false,
     "unit": "kg",
     "min": "0.01",
     "max": "100000",
     "prefill": "settlement_weight",
     "decimals": 2
    },
    {
     "key": "floor",
     "label": "送到几楼",
     "type": "number",
     "integer": true,
     "unit": "楼",
     "min": "1",
     "max": "200",
     "required": false,
     "hint": "知道楼层填楼层；步梯没有明确楼层时改填台阶数"
    },
    {
     "key": "stairs",
     "label": "步梯台阶数",
     "type": "number",
     "integer": true,
     "unit": "级",
     "min": "0",
     "max": "3200",
     "required": false,
     "hint": "从高于地面的第一级台阶算起，每 16 级算一层，不足 16 级按一层"
    },
    {
     "key": "elevator",
     "label": "有电梯",
     "type": "bool"
    },
    {
     "key": "goods_type",
     "label": "货物类型",
     "type": "choice",
     "options": [
      {
       "value": "general",
       "label": "普货"
      },
      {
       "value": "mattress",
       "label": "床垫"
      },
      {
       "value": "pallet",
       "label": "只有托/木箱包装（不拆）"
      },
      {
       "value": "mixed_pallet",
       "label": "托/木箱与其他包装混合"
      }
     ]
    },
    {
     "key": "pieces",
     "label": "货物明细",
     "type": "pieces",
     "prefill": "pieces",
     "fields": [
      {
       "key": "weight",
       "label": "单件实际重量",
       "unit": "kg",
       "min": "0"
      },
      {
       "key": "length",
       "label": "单边最长",
       "unit": "m",
       "min": "0"
      },
      {
       "key": "width",
       "label": "宽度",
       "unit": "m",
       "min": "0"
      }
     ],
     "hint": "按“件数 × 每件重量”填写；床垫类还要填长度和宽度"
    }
   ],
   "definitions": {
    "普货": {
     "type": "when",
     "cases": [
      {
       "if": {
        "all": [
         {
          "left": "elevator",
          "op": "eq",
          "value": false
         },
         {
          "left": {
           "count": "pieces",
           "where": {
            "left": "piece.weight",
            "op": "gt",
            "value": "120"
           }
          },
          "op": "ge",
          "value": "1"
         }
        ]
       },
       "then": {
        "type": "none",
        "outcome": "NEGOTIATE",
        "reason": "无电梯上楼，单件实际重量超过 120 公斤且不能拆托的，可不提供上楼服务，如需上楼寄派双方自行协商；可拆托的按拆托后计算，另收拆托费。",
        "source": {
         "document": "融辉物流网络管理手册 V6.1",
         "location": "第五篇第五章 第 52 页",
         "quote": "单票货物中单件实际重量≥120公斤且不能拆托的，可不提供上楼服务"
        }
       }
      },
      {
       "if": {
        "all": [
         {
          "left": "elevator",
          "op": "eq",
          "value": true
         },
         {
          "left": "goods_type",
          "op": "eq",
          "value": "pallet"
         }
        ]
       },
       "then": {
        "type": "when",
        "cases": [
         {
          "if": {
           "left": {
            "count": "pieces",
            "where": {
             "left": "piece.weight",
             "op": "le",
             "value": "150"
            }
           },
           "op": "eq",
           "value": "0"
          },
          "then": {
           "type": "rate",
           "rate": "15",
           "of": {
            "count": "pieces"
           },
           "label": "托/木箱有电梯（单件 >150kg）",
           "unit": "元/件",
           "source": {
            "document": "融辉物流网络管理手册 V6.1",
            "location": "第五篇第五章 第 51 页"
           }
          }
         },
         {
          "if": {
           "left": {
            "count": "pieces",
            "where": {
             "left": "piece.weight",
             "op": "gt",
             "value": "150"
            }
           },
           "op": "eq",
           "value": "0"
          },
          "then": {
           "type": "sum",
           "label": "托/木箱有电梯（单件 ≤150kg，按普货）",
           "items": [
            {
             "type": "fixed",
             "amount": "5"
            },
            {
             "type": "rate",
             "rate": "0.06",
             "of": "settlement_weight",
             "unit": "元/kg"
            }
           ],
           "source": {
            "document": "融辉物流网络管理手册 V6.1",
            "location": "第五篇第五章 第 51 页"
           }
          }
         }
        ],
        "else": {
         "type": "none",
         "outcome": "MANUAL",
         "reason": "托/木箱货物有电梯上楼，部分单件超过 150 公斤、部分不超过，手册未写明混合时怎么收。",
         "source": {
          "document": "融辉物流网络管理手册 V6.1",
          "location": "第五篇第五章 第 51 页"
         }
        }
       }
      },
      {
       "if": {
        "left": "elevator",
        "op": "eq",
        "value": true
       },
       "then": {
        "type": "sum",
        "label": "有电梯",
        "items": [
         {
          "type": "fixed",
          "amount": "5"
         },
         {
          "type": "rate",
          "rate": "0.06",
          "of": "settlement_weight",
          "unit": "元/kg"
         }
        ],
        "source": {
         "document": "融辉物流网络管理手册 V6.1",
         "location": "第五篇第五章 第 50 页"
        }
       }
      },
      {
       "if": {
        "left": {
         "first": [
          "floor",
          {
           "ceil": "stairs",
           "per": "16",
           "min": "1"
          }
         ]
        },
        "op": "gt",
        "value": "7"
       },
       "then": {
        "type": "none",
        "outcome": "NEGOTIATE",
        "reason": "无电梯送 7 楼以上：可不提供送货上楼服务，需向客户说明并联系寄件协商上楼费用。",
        "source": {
         "document": "融辉物流网络管理手册 V6.1",
         "location": "第五篇第五章 第 52 页"
        }
       }
      },
      {
       "if": {
        "left": {
         "first": [
          "floor",
          {
           "ceil": "stairs",
           "per": "16",
           "min": "1"
          }
         ]
        },
        "op": "eq",
        "value": "1"
       },
       "then": {
        "type": "fixed",
        "amount": "0",
        "label": "送到 1 楼不算上下楼，不收上楼费",
        "source": {
         "document": "融辉物流网络管理手册 V6.1",
         "location": "第五篇第五章 第 50 页",
         "quote": "由我司将客户的货物送至客户指定地址的二楼（含）以上或负一楼（含）以下处"
        }
       }
      }
     ],
     "else": {
      "type": "sum",
      "items": [
       {
        "type": "sum",
        "label": "基础费用",
        "items": [
         {
          "type": "fixed",
          "amount": "10"
         },
         {
          "type": "rate",
          "rate": "0.12",
          "of": "settlement_weight",
          "unit": "元/kg"
         }
        ],
        "source": {
         "document": "融辉物流网络管理手册 V6.1",
         "location": "第五篇第五章 第 50 页"
        }
       },
       {
        "type": "tiers",
        "by": {
         "first": [
          "floor",
          {
           "ceil": "stairs",
           "per": "16",
           "min": "1"
          }
         ]
        },
        "tiers": [
         {
          "over": null,
          "up_to": "2",
          "then": {
           "type": "fixed",
           "amount": "0"
          }
         },
         {
          "over": "2",
          "up_to": "4",
          "then": {
           "type": "rate",
           "rate": "0.05",
           "of": "settlement_weight",
           "unit": "元/kg"
          }
         },
         {
          "over": "4",
          "up_to": "6",
          "then": {
           "type": "rate",
           "rate": "0.1",
           "of": "settlement_weight",
           "unit": "元/kg"
          }
         },
         {
          "over": "6",
          "up_to": "7",
          "then": {
           "type": "rate",
           "rate": "0.15",
           "of": "settlement_weight",
           "unit": "元/kg"
          }
         }
        ],
        "label": "楼层加收",
        "source": {
         "document": "融辉物流网络管理手册 V6.1",
         "location": "第五篇第五章 第 50 页"
        }
       },
       {
        "type": "each_piece",
        "pieces": "pieces",
        "label": "单件加收",
        "source": {
         "document": "融辉物流网络管理手册 V6.1",
         "location": "第五篇第五章 第 50 页"
        },
        "item": {
         "type": "tiers",
         "by": "piece.weight",
         "tiers": [
          {
           "over": null,
           "up_to": "50",
           "then": {
            "type": "fixed",
            "amount": "0"
           }
          },
          {
           "over": "50",
           "up_to": "100",
           "then": {
            "type": "fixed",
            "amount": "10"
           }
          },
          {
           "over": "100",
           "up_to": "120",
           "then": {
            "type": "fixed",
            "amount": "30"
           }
          }
         ]
        }
       }
      ],
      "label": "无电梯上楼"
     }
    }
   },
   "formula": {
    "type": "lookup",
    "by": "goods_type",
    "rows": [
     {
      "value": "mattress",
      "then": {
       "type": "when",
       "cases": [
        {
         "if": {
          "left": {
           "count": "pieces",
           "where": {
            "left": "piece.length",
            "op": "ge",
            "value": "2.4"
           }
          },
          "op": "ge",
          "value": "1"
         },
         "then": {
          "type": "none",
          "outcome": "MANUAL",
          "reason": "有床垫单边最长 ≥2.4 米，手册收费表只写到 2.4 米以内，需人工判断。",
          "source": {
           "document": "融辉物流网络管理手册 V6.1",
           "location": "第五篇第五章 第 51–52 页"
          }
         }
        },
        {
         "if": {
          "left": {
           "count": "pieces",
           "where": {
            "any": [
             {
              "left": "piece.length",
              "op": "gt",
              "value": "1.8"
             },
             {
              "left": "piece.width",
              "op": "ge",
              "value": "1.5"
             },
             {
              "left": "piece.weight",
              "op": "gt",
              "value": "20"
             }
            ]
           }
          },
          "op": "eq",
          "value": "0"
         },
         "then": {
          "type": "use",
          "name": "普货"
         }
        },
        {
         "if": {
          "left": {
           "count": "pieces",
           "where": {
            "not": {
             "any": [
              {
               "left": "piece.length",
               "op": "gt",
               "value": "1.8"
              },
              {
               "left": "piece.width",
               "op": "ge",
               "value": "1.5"
              },
              {
               "left": "piece.weight",
               "op": "gt",
               "value": "20"
              }
             ]
            }
           }
          },
          "op": "ge",
          "value": "1"
         },
         "then": {
          "type": "none",
          "outcome": "MANUAL",
          "reason": "一票里既有床垫又有非床垫：床垫和非床垫分开计算、取大值，两部分怎么划分需人工判断。",
          "source": {
           "document": "融辉物流网络管理手册 V6.1",
           "location": "第五篇第五章 第 52 页"
          }
         }
        },
        {
         "if": {
          "left": "elevator",
          "op": "eq",
          "value": true
         },
         "then": {
          "type": "clamp",
          "item": {
           "type": "sum",
           "items": [
            {
             "type": "fixed",
             "amount": "30"
            },
            {
             "type": "rate",
             "rate": "10",
             "of": {
              "excess": {
               "count": "pieces"
              },
              "over": "1"
             },
             "unit": "元/件"
            }
           ],
           "label": "床垫有电梯"
          },
          "max": "400",
          "source": {
           "document": "融辉物流网络管理手册 V6.1",
           "location": "第五篇第五章 第 51–52 页"
          }
         }
        }
       ],
       "else": {
        "type": "clamp",
        "item": {
         "type": "sum",
         "items": [
          {
           "type": "fixed",
           "amount": "60"
          },
          {
           "type": "rate",
           "rate": "20",
           "of": {
            "excess": {
             "count": "pieces"
            },
            "over": "1"
           },
           "unit": "元/件"
          }
         ],
         "label": "床垫无电梯"
        },
        "max": "400",
        "source": {
         "document": "融辉物流网络管理手册 V6.1",
         "location": "第五篇第五章 第 51–52 页"
        }
       }
      }
     }
    ],
    "else": {
     "type": "use",
     "name": "普货"
    }
   },
   "group": "上楼卸货",
   "reminders": [
    "上楼费和卸货费不可同时收取，同时产生时取大值。",
    "一票多件送到不同楼层的，按整票送至最高楼层计算。"
   ]
  },
  "checks": [
   {
    "text": "基础费、有电梯收费、楼层加收、单件加收逐格对照手册第 50 页原表核对。",
    "done": false
   },
   {
    "text": "托/木箱有电梯：单件有的超过 150 公斤、有的不超过时手册未写明，目前按“需人工判断”（第 51 页）。",
    "done": false
   },
   {
    "text": "床垫与非床垫混在一票：分开计算取大，两部分怎么划分需人工判断（第 52 页）。",
    "done": false
   },
   {
    "text": "床垫收费表（首件、续件、封顶 400 元）对照第 51–52 页核对。",
    "done": false
   },
   {
    "text": "执行日期以总部通知为准，尚未填写。",
    "done": false
   }
  ]
 },
 "unloading": {
  "name": "卸货费",
  "content": {
   "schema": 1,
   "params": [
    {
     "key": "settlement_weight",
     "label": "结算重量",
     "type": "number",
     "integer": false,
     "unit": "kg",
     "min": "0.01",
     "max": "100000",
     "prefill": "settlement_weight",
     "decimals": 2
    },
    {
     "key": "pieces",
     "label": "货物明细",
     "type": "pieces",
     "prefill": "pieces",
     "fields": [
      {
       "key": "weight",
       "label": "单件实际重量",
       "unit": "kg",
       "min": "0"
      },
      {
       "key": "length",
       "label": "单边最长",
       "unit": "m",
       "min": "0"
      },
      {
       "key": "width",
       "label": "宽度",
       "unit": "m",
       "min": "0"
      }
     ],
     "hint": "按“件数 × 每件重量”填写；床垫类还要填长度和宽度"
    }
   ],
   "formula": {
    "type": "max",
    "items": [
     {
      "type": "tiers",
      "by": "settlement_weight",
      "tiers": [
       {
        "over": null,
        "up_to": "1500",
        "then": {
         "type": "fixed",
         "amount": "0"
        }
       },
       {
        "over": "1500",
        "up_to": null,
        "then": {
         "type": "clamp",
         "item": {
          "type": "rate",
          "rate": "0.015",
          "of": "settlement_weight",
          "unit": "元/kg"
         },
         "min": "25",
         "max": "300"
        }
       }
      ],
      "label": "单票超重超大",
      "source": {
       "document": "融辉物流网络管理手册 V6.1",
       "location": "第五篇第三章 第 46–47 页"
      }
     },
     {
      "type": "each_piece",
      "pieces": "pieces",
      "label": "单件超重超大",
      "source": {
       "document": "融辉物流网络管理手册 V6.1",
       "location": "第五篇第三章 第 47 页"
      },
      "item": {
       "type": "tiers",
       "by": "piece.weight",
       "tiers": [
        {
         "over": null,
         "up_to": "1500",
         "then": {
          "type": "fixed",
          "amount": "0"
         }
        },
        {
         "over": "1500",
         "up_to": null,
         "then": {
          "type": "fixed",
          "amount": "50"
         }
        }
       ]
      }
     }
    ],
    "label": "单票与单件分别计算取大"
   },
   "group": "上楼卸货",
   "reminders": [
    "需开单备注并登记问题件通知派送网点（两者都要），否则默认末端无需卸货。",
    "派件司机不参与卸货、全程由收件客户自行卸货的不收卸货费。",
    "上楼费和卸货费不可同时收取，同时产生时取大值。"
   ]
  },
  "checks": [
   {
    "text": "单票 >1500kg 0.015 元/kg（最低 25、最高 300）、单件 >1500kg 50 元/件对照第 46–47 页核对。",
    "done": false
   },
   {
    "text": "手册表头写结算重量，第 48 页例子用实际重量，填哪个请统一。",
    "done": false
   },
   {
    "text": "执行日期以总部通知为准，尚未填写。",
    "done": false
   }
  ]
 },
 "unpacking": {
  "name": "拆托/拆木架木箱",
  "content": {
   "schema": 1,
   "params": [
    {
     "key": "pallet_count",
     "label": "拆托个数",
     "type": "number",
     "integer": true,
     "unit": "个",
     "min": "0",
     "max": "10000",
     "default": "0"
    },
    {
     "key": "crate_count",
     "label": "拆木架/木箱件数",
     "type": "number",
     "integer": true,
     "unit": "件",
     "min": "0",
     "max": "10000",
     "default": "0"
    }
   ],
   "formula": {
    "type": "sum",
    "items": [
     {
      "type": "tiers",
      "by": "pallet_count",
      "tiers": [
       {
        "over": null,
        "up_to": "2",
        "then": {
         "type": "fixed",
         "amount": "0"
        }
       },
       {
        "over": "2",
        "up_to": null,
        "then": {
         "type": "sum",
         "items": [
          {
           "type": "fixed",
           "amount": "10"
          },
          {
           "type": "rate",
           "rate": "5",
           "of": {
            "excess": "pallet_count",
            "over": "3"
           },
           "unit": "元/个"
          }
         ]
        }
       }
      ],
      "label": "拆托",
      "source": {
       "document": "融辉物流网络管理手册 V6.1",
       "location": "第五篇第九章 第 59 页",
       "quote": "单票3件以上（含3件），起收费10元，每多一件加5元"
      }
     },
     {
      "type": "rate",
      "rate": "10",
      "of": "crate_count",
      "label": "拆木架、拆木箱",
      "unit": "元/件",
      "source": {
       "document": "融辉物流网络管理手册 V6.1",
       "location": "第五篇第九章 第 59 页"
      }
     }
    ],
    "label": "拆托/木架/木箱"
