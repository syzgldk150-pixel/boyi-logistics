     "integer": true,
     "unit": "件",
     "min": "0",
     "max": "100000",
     "default": "0"
    }
   ],
   "formula": {
    "type": "max",
    "items": [
     {
      "type": "tiers",
      "by": "sort_count",
      "tiers": [
       {
        "over": null,
        "up_to": "30",
        "then": {
         "type": "fixed",
         "amount": "0"
        }
       },
       {
        "over": "30",
        "up_to": null,
        "then": {
         "type": "clamp",
         "item": {
          "type": "rate",
          "rate": "0.2",
          "of": "sort_count",
          "unit": "元/件"
         },
         "min": "10",
         "max": "300"
        }
       }
      ],
      "label": "分类码放",
      "source": {
       "document": "融辉物流网络管理手册 V6.1",
       "location": "第五篇第十一章 第 61 页"
      }
     },
     {
      "type": "when",
      "cases": [
       {
        "if": {
         "left": "shelf_count",
         "op": "eq",
         "value": "0"
        },
        "then": {
         "type": "fixed",
         "amount": "0"
        }
       },
       {
        "if": {
         "left": "shelf_high",
         "op": "eq",
         "value": true
        },
        "then": {
         "type": "clamp",
         "item": {
          "type": "rate",
          "rate": "0.5",
          "of": "shelf_count",
          "unit": "元/件"
         },
         "max": "500"
        }
       }
      ],
      "else": {
       "type": "tiers",
       "by": "shelf_count",
       "tiers": [
        {
         "over": null,
         "up_to": "30",
         "then": {
          "type": "fixed",
          "amount": "0"
         }
        },
        {
         "over": "30",
         "up_to": null,
         "then": {
          "type": "clamp",
          "item": {
           "type": "rate",
           "rate": "0.2",
           "of": "shelf_count",
           "unit": "元/件"
          },
          "min": "10",
          "max": "300"
         }
        }
       ]
      },
      "label": "码放上架",
      "source": {
       "document": "融辉物流网络管理手册 V6.1",
       "location": "第五篇第十一章 第 61 页"
      }
     },
     {
      "type": "tiers",
      "by": "room_count",
      "tiers": [
       {
        "over": null,
        "up_to": "3",
        "then": {
         "type": "fixed",
         "amount": "0"
        }
       },
       {
        "over": "3",
        "up_to": null,
        "then": {
         "type": "clamp",
         "item": {
          "type": "rate",
          "rate": "2",
          "of": "room_piece_count",
          "unit": "元/件"
         },
         "max": "100"
        }
       }
      ],
      "label": "分房号码放",
      "source": {
       "document": "融辉物流网络管理手册 V6.1",
       "location": "第五篇第十一章 第 61 页"
      }
     }
    ],
    "label": "三种码放取最高"
   },
   "group": "清点码放",
   "reminders": [
